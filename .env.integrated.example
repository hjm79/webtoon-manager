# Copy to .env.integrated. Keep existing paths and credential values during an upgrade.
WEB_BIND_IP=192.168.1.26
WEB_PORT=8230
WEB_PUBLIC_ORIGIN=http://192.168.1.26:8230
WEBTOON_DOWNLOAD_HOST_PATH=/mnt/nvme500/webtoon/downloads
WEBTOON_ARCHIVE_HOST_PATH=/mnt/nvme500/webtoon/archive
APP_DATA_HOST_PATH=/DATA/AppData/webtoon-manager/data
COOKIE_DIR_HOST_PATH=/DATA/AppData/webtoon-manager/cookies
COOKIE_FILE_NAME=cookies.json
VIEWER_DATA_HOST_PATH=/DATA/AppData/webtoon-server/data
# Use the current viewer integration token; do not rotate it during repository consolidation.
VIEWER_INTEGRATION_TOKEN=
SUPPORTER_API_TOKEN=
VIEWER_PROFILES_ENABLED=false
WEBTOON_MANAGER_IMAGE=local/webtoon-manager:integrated
WEBTOON_VIEWER_IMAGE=local/webtoon-manager-viewer:integrated
